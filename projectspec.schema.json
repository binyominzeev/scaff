{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectSpec YAML front matter v0.1",
  "type": "object",
  "required": ["spec_version", "project", "stack", "database", "api", "auth", "pwa", "deployment"],
  "properties": {
    "spec_version": { "type": "string", "const": "0.1" },

    "project": {
      "type": "object",
      "required": ["name", "type", "one_liner"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "kebab-case, ez lesz a repó/mappa neve is"
        },
        "type": {
          "type": "string",
          "enum": ["web-app", "pwa", "api-only"]
        },
        "one_liner": { "type": "string" }
      }
    },

    "stack": {
      "type": "object",
      "required": ["framework", "language", "styling"],
      "properties": {
        "framework": { "type": "string", "enum": ["nextjs-app-router", "vite-react"] },
        "language": { "type": "string", "enum": ["typescript"] },
        "styling": { "type": "string", "enum": ["tailwind-v3", "tailwind-v4", "none"] },
        "router": {
          "type": ["string", "null"],
          "enum": ["react-router", null],
          "description": "csak vite-react esetén releváns"
        }
      }
    },

    "database": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "type": "string", "enum": ["none", "sqlite", "postgres"] },
        "orm": { "type": "string", "enum": ["none", "prisma", "raw-driver"] },
        "seed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["engine", "orm"] }
        }
      ]
    },

    "api": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { "type": "string", "enum": ["route-handlers", "none"] }
      }
    },

    "auth": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["none", "next-auth-credentials"] }
      }
    },

    "ai_integration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["none", "openai", "custom-server"] },
        "purpose": { "type": ["string", "null"] }
      }
    },

    "pwa": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "offline": { "type": "boolean" }
      }
    },

    "deployment": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "enum": ["local-dev", "docker-vps", "pm2"] },
        "docker": { "type": "boolean" }
      }
    }
  }
}
